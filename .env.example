# Local Docker Compose credentials. Replace every value outside disposable
# development environments.
PARSER_SERVE_API_KEY=parser_0123456789abcdef0123456789abcdef
PARSER_WORKER_API_KEY=parser_fedcba9876543210fedcba9876543210
POSTGRES_PASSWORD=parser_serve_dev_password
MINIO_ROOT_USER=parser_serve
MINIO_ROOT_PASSWORD=parser_serve_dev_password

# Optional immutable release metadata exposed by /api/v1/system/info.
BUILD_COMMIT=
BUILD_TIME=

# Worker-enforced ceilings. Pipeline parameters may lower but never raise them.
MAXIMUM_PDF_PAGES=1000
MAXIMUM_IMAGE_PIXELS=100000000
MAXIMUM_MEDIA_DURATION_SECONDS=14400

# Control-plane retention lifecycle. Set
# PARSER_SERVE_RETENTION_CLEANUP_ENABLED=false to disable the background loop.
UPLOADED_FILE_RETENTION_SECONDS=86400
ARTIFACT_RETENTION_SECONDS=2592000
EVENT_RETENTION_SECONDS=604800
SSE_MAXIMUM_SEND_DELAY_SECONDS=30
SCHEDULER_MAXIMUM_DEVICE_MEMORY_UTILIZATION_PERCENT=95
RETENTION_CLEANUP_INTERVAL_SECONDS=300
RETENTION_CLEANUP_BATCH_SIZE=500

# Hardware profiles require a vetted vendor image containing Python 3.12/3.13.
CUDA_BASE_IMAGE=
CUDA_PRELOAD_BACKENDS=[]
ASCEND_BASE_IMAGE=
MLU_BASE_IMAGE=
DCU_BASE_IMAGE=
MUSA_BASE_IMAGE=
XPU_BASE_IMAGE=

# Optional JSON command returning HardwareProbeSnapshot 1.0 for domestic
# accelerators. Compose parses JSON arrays from these environment values.
ASCEND_DEVICE_PROBE_COMMAND=[]
MLU_DEVICE_PROBE_COMMAND=[]
DCU_DEVICE_PROBE_COMMAND=[]
MUSA_DEVICE_PROBE_COMMAND=[]
XPU_DEVICE_PROBE_COMMAND=[]
