{
  "name": "parser-serve-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "cd .. && python -m scripts.export_openapi && python -m scripts.generate_typescript_sdk",
    "check:api": "cd .. && python -m scripts.generate_typescript_sdk --check",
    "check:sdk": "tsc -p tsconfig.sdk.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@vue/tsconfig": "^0.8.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "shadcn-vue": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
